{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "python3 -m pip install --upgrade pip && python3 -m pip install -e \".[docs]\"",
  "buildCommand": "python3 -m sphinx -b html docs docs/_build/html",
  "outputDirectory": "docs/_build/html",
  "cleanUrls": true,
  "trailingSlash": false
}
