# EZRA local config example
#
# Customize (pick one):
#   1) cp ezra.yaml.example ezra.yaml          # repo-local (gitignored)
#   2) mkdir -p ~/.ezra && cp ezra.yaml.example ~/.ezra/ezra.yaml
#   3) Personal agent (prompt + preferred models):
#        ezra agents init my-lab-assistant
#      See agents/README.md and docs/agents.md
#   4) On HPC, prefer a shareable site profile instead:
#        ezra hpc init-site my-cluster --models-dir /scratch/$USER/ezra/models
#        export EZRA_SITE=my-cluster
#      See sites/README.md
#
# Search for EDIT ME below. Do not put HF_TOKEN or passwords in this file.

version: 1

local:
  backend: auto               # auto | llama | mlx | stub
  # EDIT ME: where weights live (HPC: use scratch / project FS)
  # Or skip this and: export EZRA_MODELS_DIR=/scratch/$USER/ezra/models
  models_dir: ~/.ezra/models
  prefer_quant: auto          # auto | Q4_K_M | Q5_K_M | Q8_0 | fp16 | bf16
  max_workers: 2
  resume: true
  hf_token_env: HF_TOKEN      # export HF_TOKEN=… separately (.env is gitignored)
  max_loaded: 2
  n_ctx: 4096
  n_gpu_layers: -1            # or export EZRA_N_GPU_LAYERS

router:
  mode: auto

# Document parsing for LLM ingestion (PDF / Office via MegaParse)
parse:
  backend: auto               # auto | basic | megaparse
  strategy: auto              # auto | fast | hi_res

# macOS Peekaboo (screen capture / UI automation / MCP) — see docs/peekaboo.md
peekaboo:
  enabled: auto               # auto | on | off
  # cli: ""                   # optional absolute path; or EZRA_PEEKABOO_CLI

# Google Workspace via gogcli (`gog`) — see docs/gog.md
gog:
  enabled: auto               # auto | on | off
  # cli: ""                   # optional path; or EZRA_GOG_CLI
  # account: you@gmail.com    # or GOG_ACCOUNT / EZRA_GOG_ACCOUNT

# OpenClaw personal AI Gateway — see docs/openclaw.md (full in-tree snapshot)
openclaw:
  enabled: auto               # auto | on | off
  # cli: ""                   # optional path; or EZRA_OPENCLAW_CLI

# Cline coding agent — see docs/cline.md (full in-tree snapshot)
cline:
  enabled: auto               # auto | on | off
  # cli: ""                   # optional path; or EZRA_CLINE_CLI

hpc:
  enabled: false
  endpoints: []
  # For cluster defaults, use sites/<name>/ezra.yaml (init-site), not this file.
