# ── Local config & secrets (copy from *.example; do not commit) ─────────────
# Repo-root personal override (use: cp ezra.yaml.example ezra.yaml)
/ezra.yaml
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.yaml
secrets.yml

# Personal-only site folder (optional; shareable sites/<name>/ stay tracked)
sites/local/
sites/_local/

# Personal-only agents (shareable agents/<name>/ stay tracked)
agents/local/
agents/_local/

# Site-local secrets if someone drops them in a profile
sites/**/.env
sites/**/secrets.*

# ── EZRA runtime / model weights ────────────────────────────────────────────
.ezra/
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.onnx
*.ggml
models/
!src/ezra/gallery/

# Hugging Face / download scratch
.cache/
huggingface/

# ── SLURM / job logs ────────────────────────────────────────────────────────
*.out
*.err
slurm-*.out
ezra-*-*.out
ezra-*-*.err

# ── Docs (Sphinx) ───────────────────────────────────────────────────────────
docs/_build/
docs/api/_autosummary/

.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
