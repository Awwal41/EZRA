# EZRA environment example
# Customize:  cp .env.example .env   then edit  (`.env` is gitignored)
#
# Load into your shell however you prefer, e.g.:
#   set -a && source .env && set +a          # bash
#   Get-Content .env | ForEach-Object { … }  # PowerShell (or use direnv)
#
# Do NOT commit real tokens.

# ── EDIT ME: optional paths ─────────────────────────────────────────────────
# EZRA_MODELS_DIR=/scratch/$USER/ezra/models
# EZRA_HOME=/scratch/$USER/ezra
# EZRA_ROOT=/path/to/EZRA

# ── EDIT ME: HPC site profile (after: ezra hpc init-site my-cluster) ────────
# EZRA_SITE=my-cluster

# ── EDIT ME: Hugging Face (gated models only) ───────────────────────────────
# HF_TOKEN=hf_xxxxxxxx

# Optional serve / job knobs
# EZRA_HOST=0.0.0.0
# EZRA_PORT=8000
# EZRA_WORKERS=2
# MODEL=qwen2.5-7b-instruct

# Optional vendor CLIs (see docs/peekaboo.md, docs/gog.md, docs/openclaw.md)
# EZRA_PEEKABOO_CLI=/opt/homebrew/bin/peekaboo
# EZRA_PEEKABOO_ROOT=/path/to/Peekaboo
# EZRA_GOG_CLI=/usr/local/bin/gog
# EZRA_GOG_ROOT=/path/to/gogcli
# GOG_ACCOUNT=you@gmail.com
# EZRA_OPENCLAW_CLI=/usr/local/bin/openclaw
# EZRA_OPENCLAW_ROOT=/path/to/OpenClaw
